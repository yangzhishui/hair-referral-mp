page {
  --primary: #12a89c;
  --primary-dark: #0d8b81;
  --primary-light: #e6f7f5;
  --blue: #2b7cff;
  --orange: #ff9800;
  --red: #f5222d;
  --text: #1f2329;
  --sub: #8a9099;
  --border: #eef0f3;
  --bg: #f5f7fa;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  line-height: 1.6;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  padding: 24rpx 24rpx 48rpx;
}

.page-pad-bottom {
  padding-bottom: 160rpx;
}

.flex {
  display: flex;
}

.flex-1 {
  flex: 1;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.wrap {
  flex-wrap: wrap;
}

.gap-8 { gap: 8rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--primary);
  margin-right: 14rpx;
}

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* ---------- 文本 ---------- */
.t-lg { font-size: 34rpx; font-weight: 600; }
.t-md { font-size: 30rpx; }
.t-sm { font-size: 26rpx; }
.t-xs { font-size: 24rpx; }
.t-sub { color: var(--sub); }
.t-primary { color: var(--primary); }
.t-blue { color: var(--blue); }
.t-orange { color: var(--orange); }
.t-red { color: var(--red); }
.t-bold { font-weight: 600; }
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: var(--primary-light);
  color: var(--primary);
  margin: 0 12rpx 12rpx 0;
}

.tag-gray {
  background: #f2f3f5;
  color: var(--sub);
}

.tag-blue {
  background: #e8f1ff;
  color: var(--blue);
}

.tag-orange {
  background: #fff3e0;
  color: var(--orange);
}

.tag-red {
  background: #ffebee;
  color: var(--red);
}

/* ---------- 按钮 ---------- */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-primary.btn-disabled {
  background: #b6e0db;
}

.btn-ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-gray {
  background: #f2f3f5;
  color: var(--sub);
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
}

.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(31, 35, 41, 0.06);
  z-index: 10;
}

/* ---------- 表单 ---------- */
.form-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 200rpx;
  flex-shrink: 0;
  color: var(--sub);
  font-size: 28rpx;
  line-height: 48rpx;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  line-height: 48rpx;
  min-height: 48rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  height: 48rpx;
  line-height: 48rpx;
}

.textarea {
  width: 100%;
  font-size: 28rpx;
  min-height: 140rpx;
  line-height: 44rpx;
  padding: 16rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}

.picker-placeholder {
  color: #c0c4cc;
}

/* ---------- 列表行 ---------- */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.cell:last-child {
  border-bottom: none;
}

.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #c9ced6;
  border-right: 3rpx solid #c9ced6;
  transform: rotate(45deg);
  margin-left: 12rpx;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--sub);
}

/* ---------- 搜索 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  margin-bottom: 24rpx;
}

.search-bar input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 12rpx;
}

/* ---------- 分段 tab ---------- */
.segment {
  display: flex;
  background: #fff;
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--sub);
  border-radius: 32rpx;
}

.segment-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

/* ---------- 头像 ---------- */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-light);
  flex-shrink: 0;
}

.avatar-lg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--primary-light);
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary-light);
}

/* ---------- 图片九宫格 ---------- */
.grid-3 {
  display: flex;
  flex-wrap: wrap;
}

.grid-3-item {
  width: calc((100% - 32rpx) / 3);
  height: 200rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background: #f2f3f5;
}

.grid-3-item:nth-child(3n) {
  margin-right: 0;
}

.grid-3-item image {
  width: 100%;
  height: 100%;
}

.grid-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--sub);
  font-size: 22rpx;
  border: 2rpx dashed #dcdfe6;
}

.close-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  border-radius: 0 0 0 12rpx;
}

/* ---------- 其他 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.badge-dot {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--red);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

.hairline-top {
  border-top: 1rpx solid var(--border);
}
