.patient-head {
  background: linear-gradient(135deg, #ffffff, #e6f7f5);
}

.img-group {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.img-group:last-child {
  border-bottom: none;
}

.ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e6f7f5, #eaf1ff);
  color: #8a9099;
  font-size: 22rpx;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.record-item:last-child {
  border-bottom: none;
}
