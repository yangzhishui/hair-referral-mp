.ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e6f7f5, #eaf1ff);
  color: #8a9099;
  font-size: 22rpx;
}

.rec-item,
.msg-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.rec-item:last-child,
.msg-item:last-child {
  border-bottom: none;
}
