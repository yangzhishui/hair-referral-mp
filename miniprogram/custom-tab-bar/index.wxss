.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 16rpx rgba(31, 35, 41, 0.06);
  z-index: 999;
}

.tab-item {
  flex: 1;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a9099;
}

.tab-item.active {
  color: #12a89c;
}

.tab-icon {
  font-size: 34rpx;
  line-height: 1.2;
}

.tab-text {
  font-size: 20rpx;
  margin-top: 4rpx;
}
