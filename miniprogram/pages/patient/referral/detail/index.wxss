.status-card {
  border-left: 8rpx solid #ff9800;
}

.status-card.status-accepted,
.status-card.status-in_progress {
  border-left-color: #2b7cff;
}

.status-card.status-closed {
  border-left-color: #12a89c;
}

.status-card.status-cancelled {
  border-left-color: #9aa0a6;
}

.img-group {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.img-group:last-child {
  border-bottom: none;
}

.ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e6f7f5, #eaf1ff);
  color: #8a9099;
  font-size: 22rpx;
}

.rec-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.rec-item:last-child {
  border-bottom: none;
}

.log-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.log-item:last-child {
  border-bottom: none;
}
