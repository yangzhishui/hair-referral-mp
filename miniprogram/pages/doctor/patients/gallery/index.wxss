.cat-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--sub);
}

.cat-item.active {
  background: #12a89c;
  color: #fff;
  font-weight: 600;
}

.img-box {
  position: relative;
  height: 240rpx;
}

.ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e6f7f5, #eaf1ff);
  color: #8a9099;
  font-size: 22rpx;
}

.img-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 10rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 20rpx;
}

.img-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 10rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  color: #fff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.check.checked {
  background: #12a89c;
  border-color: #12a89c;
}

.compare-box {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 20vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 200;
}

.cmp-img {
  width: 100%;
  height: 320rpx;
  background: #f2f3f5;
  border-radius: 12rpx;
}
